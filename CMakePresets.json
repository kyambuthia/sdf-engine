{
  "version": 5,
  "configurePresets": [
    {
      "name": "web",
      "displayName": "WebAssembly (Emscripten + WebGL2)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-web",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
      }
    },
    {
      "name": "desktop",
      "displayName": "Desktop Native (OpenGL ES 3)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-desktop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "android",
      "displayName": "Android (NDK + SDL3 + GLES3)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-android",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-26"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "web",
      "configurePreset": "web"
    },
    {
      "name": "desktop",
      "configurePreset": "desktop"
    },
    {
      "name": "android",
      "configurePreset": "android"
    }
  ]
}
